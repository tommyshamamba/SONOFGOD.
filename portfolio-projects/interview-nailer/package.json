{
  "name": "interview-nailer",
  "private": true,
  "scripts": {
    "build:render": "npm --prefix backend install && npm --prefix frontend install && npm --prefix frontend run build",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend start",
    "build:frontend": "npm --prefix frontend run build",
    "db:init": "npm --prefix backend run db:init"
  }
}
