{
  "name": "interview-nailer",
  "private": true,
  "scripts": {
    "build:render": "npm --prefix backend ci --omit=dev && npm --prefix frontend ci --include=dev && npm --prefix frontend run build",
    "install:backend": "npm --prefix backend ci",
    "install:frontend": "npm --prefix frontend ci",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend start",
    "build:frontend": "npm --prefix frontend run build",
    "db:init": "npm --prefix backend run db:init",
    "test": "npm --prefix backend test"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
