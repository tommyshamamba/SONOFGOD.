PORT=5000
NODE_ENV=development

# Comma-separated list is supported.
CLIENT_URL=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Local demo mode works without PostgreSQL or Anthropic.
STORAGE_MODE=file
AI_MODE=mock
ANTHROPIC_MODEL=claude-sonnet-4-20250514
DATABASE_SSL=false
# Production requires PostgreSQL, a random 32+ character signing secret,
# and HTTPS. Set ALLOW_MOCK_AI=true only for an explicitly labeled hosted demo.
STORE_FILE=./data/store.json

# Switch to postgres + anthropic when you are ready for real services.
DATABASE_URL=postgresql://user:password@host:5432/interview_nailer
ANTHROPIC_API_KEY=your_anthropic_api_key_here
