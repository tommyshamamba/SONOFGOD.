PORT=5000
NODE_ENV=development

# Comma-separated list is supported.
CLIENT_URL=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Local demo mode works without PostgreSQL or Anthropic.
STORAGE_MODE=file
AI_MODE=mock
STORE_FILE=./data/store.json

# Switch to postgres + anthropic when you are ready for real services.
DATABASE_URL=postgresql://user:password@host:5432/interview_nailer
ANTHROPIC_API_KEY=your_anthropic_api_key_here
