{
  "name": "pesa-fams-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype and PostgreSQL-backed MVP foundation for the Bank DRC Fixed Asset Management System",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
