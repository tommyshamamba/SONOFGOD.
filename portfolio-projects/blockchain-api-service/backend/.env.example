PORT=3300
HOST=127.0.0.1
DEMO_MODE=true
DATA_FILE=./data/store.json
CORS_ORIGIN=http://localhost:3002,http://127.0.0.1:3002
ENABLE_TRANSACTION_BROADCAST=false

# Local demo mode uses a generated signing secret and an in-memory limiter.
# Hosted operation requires a random JWT_SECRET, REDIS_URL, HTTPS CORS_ORIGIN,
# persistent DATA_FILE and DEMO_MODE=false. See README before deployment.
# JWT_SECRET=
# REDIS_URL=redis://localhost:6379

# Blockchain RPC Endpoints (replace with your own nodes for production)
ETH_RPC_URL=https://eth.llamarpc.com
POLYGON_RPC_URL=https://polygon.llamarpc.com
ARBITRUM_RPC_URL=https://arbitrum.llamarpc.com
OPTIMISM_RPC_URL=https://optimism.llamarpc.com
